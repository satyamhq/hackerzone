# ==============================================================================
# HACKERZONE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Duplicate this file as .env.local for local development.
# Configure these variables in Vercel Project Settings for Staging and Production.
# NEVER commit real credentials, secrets, or service role keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION URLs
# ------------------------------------------------------------------------------
# The canonical public URL of the application. Used for absolute links, OAuth callbacks, and SEO.
# Local: http://localhost:3000
# Production: https://hackerzone.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Auth, Database, Storage)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-only Service Role Key (NEVER expose to browser client-side code)
# Used for backend administrative operations, webhook verification, and system tasks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Direct PostgreSQL connection string (Used for Prisma/Drizzle/migration pipelines)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. OBSERVABILITY & ERROR TRACKING (Sentry / LogRocket)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ------------------------------------------------------------------------------
# 4. ANALYTICS & MONITORING
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ID=hz-analytics-prod

# ------------------------------------------------------------------------------
# 5. FEATURE FLAGS
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_AI_EVALUATION=true
# NEXT_PUBLIC_ENABLE_ENTERPRISE_API=true
